n1 := comp (pair (take (iden)) (drop (iden))) (jet_fe_multiply)
n2 := comp (pair (take (iden)) (drop (iden))) (jet_scalar_multiply)
k3 := comp unit (const 0x41a381d4fbc422ef8d23ee383ae5cee9fc0acb6563f84bcb7fc6e686fcd81f60)
n4 := comp (pair (n1) (k3)) (jet_fe_multiply)
k5 := comp unit (const 0x30644e72e131a029b85045b68181585d97816a916871ca8d3c208c16d87cfd47)
n6 := comp (pair (n4) (k5)) (jet_scalar_multiply)
n7 := comp (pair (n2) (n6)) (jet_scalar_add)
k8 := comp unit (const 0xa57bdc004d93728c4bc18a61f6631708569fa14fe13edb7f8f3107a7a3e12be1)
n9 := comp (pair (n7) (k8)) (jet_scalar_multiply)
k10 := comp unit (const 0x0229747b29e4416505ccb29c373055ec9ad9278333dd9d8b6ca1ddc40784b131)
n11 := comp (pair (iden) (k10)) (jet_eq_256)
k12 := comp unit (const 0x328dc2ee0b15e18ebe1cf852b8b1ae4a325a92149c4f6818a8c269dae001ae78)
n13 := comp (pair (iden) (k12)) (jet_eq_256)
n14 := comp (pair (n11) (n13)) (jet_or_1)
n15 := comp (n14) (jet_verify)
w_in := witness : _ -> (2^256 * 2^256)
main := comp w_in (comp (n9) (n15))
